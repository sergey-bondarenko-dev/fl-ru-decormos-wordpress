{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "decormos/hero",
	"version": "0.1.0",
	"title": "Первый экран",
	"category": "decormos",
	"icon": "cover-image",
	"description": "Главный баннер на весь экран.",
	"example": {},
	"attributes": {
		"backgroundImageId": {
			"type": "number",
			"default": 0
		},
		"usePostImage": {
			"type": "boolean",
			"default": false
		},
		"backgroundVideoId": {
			"type": "number",
			"default": 0
		},
		"showVideoOnMobileOnly": {
			"type": "boolean",
			"default": true
		},
		"usePostVideoSettings": {
			"type": "boolean",
			"default": false
		},
		"considerHeaderOffset": {
			"type": "boolean",
			"default": false
		},
		"headerSelector": {
			"type": "string",
			"default": ".header"
		},
		"heroBackgroundOpacity": {
			"type": "number",
			"default": 0.3
		}
	},
	"supports": {
		"html": false,
		"layout": {
			"default": {
				"type": "flex",
				"orientation": "vertical"
			},
			"allowOrientation": false,
			"allowJustification": true,
			"allowVerticalAlignment": true
		},
		"spacing": {
			"padding": true
		}
	},
	"textdomain": "decormos-blocks",
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
