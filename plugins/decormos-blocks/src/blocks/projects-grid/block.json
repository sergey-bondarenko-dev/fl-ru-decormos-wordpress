{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "decormos/projects-grid",
	"version": "0.1.0",
	"title": "Сетка проектов",
	"category": "decormos",
	"icon": "grid-view",
	"description": "Динамическая сетка проектов.",
	"attributes": {
		"termId": {
			"type": "number",
			"default": 0
		},
		"postsPerPage": {
			"type": "number",
			"default": 12
		},
		"order": {
			"type": "string",
			"default": "desc"
		},
		"orderBy": {
			"type": "string",
			"default": "date"
		},
		"ctaText": {
			"type": "string",
			"default": "Примеры работ"
		},
		"notFoundText": {
			"type": "string",
			"default": "Проекты не найдены."
		},
		"loadMoreText": {
			"type": "string",
			"default": "Больше проектов"
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "decormos-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
