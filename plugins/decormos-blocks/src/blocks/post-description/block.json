{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "decormos/post-description",
	"version": "0.1.0",
	"title": "Описание записи",
	"category": "decormos",
	"icon": "editor-paragraph",
	"description": "Выводит описание текущей записи из meta-поля decormos_post_description.",
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"color": {
			"text": true,
			"background": true,
			"gradients": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"fontFamily": true,
			"fontWeight": true,
			"fontStyle": true,
			"textTransform": true,
			"textDecoration": true,
			"letterSpacing": true
		}
	},
	"textdomain": "decormos-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
